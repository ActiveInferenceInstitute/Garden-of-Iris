# Environment variable template for Garden-of-Iris.
# Copy to a local .env (never commit it) or export in your shell.

# Primary: OpenRouter API key. Used by discord_bot.py, hindsight.py, and
# parse_fourthought.py via openai_legacy.py, which routes all model calls
# through https://openrouter.ai/api/v1.
OPENROUTER_API_KEY=

# Fallback only: used when OPENROUTER_API_KEY is unset.
OPENAI_API_KEY=

# Used by discord_bot.py (Discord bot token)
DISCORD_BOT_KEY=

# Used by discord_bot.py (Airtable tarot deck lookup)
AIRTABLE_API_KEY=
